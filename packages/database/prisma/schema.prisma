generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @db.VarChar(120)
  email        String           @unique @db.VarChar(254)
  phone        String?          @db.VarChar(32)
  passwordHash String           @map("password_hash")
  role         UserRole         @default(CUSTOMER)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  sessions     RefreshSession[]
  orders       Order[]

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Category {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String    @unique @db.VarChar(80)
  name         String    @unique @db.VarChar(120)
  description  String    @default("")
  imageUrl     String?   @map("image_url")
  active       Boolean   @default(true)
  displayOrder Int       @default(0) @map("display_order")
  products     Product[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(160)
  description String           @db.Text
  categoryId  String           @map("category_id") @db.Uuid
  featured    Boolean          @default(false)
  active      Boolean          @default(true)
  comingSoon  Boolean          @default(false) @map("coming_soon")
  rating      Float            @default(0)
  reviewCount Int              @default(0) @map("review_count")
  variants    ProductVariant[]
  orderItems  OrderItem[]
  category    Category         @relation(fields: [categoryId], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([active, featured, categoryId])
  @@map("products")
}

model ProductVariant {
  id         String      @id @default(uuid()) @db.Uuid
  productId  String      @map("product_id") @db.Uuid
  slug       String      @db.VarChar(80)
  label      String      @db.VarChar(80)
  price      Decimal     @db.Decimal(12, 2)
  stock      Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([productId, slug])
  @@index([stock])
  @@map("product_variants")
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  orderNumber   String        @unique @map("order_number") @db.VarChar(24)
  userId        String        @map("user_id") @db.Uuid
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentReference String?   @unique @map("payment_reference") @db.VarChar(100)
  subtotal      Decimal       @db.Decimal(12, 2)
  deliveryFee   Decimal       @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  address       String        @db.Text
  deliveryState String        @map("delivery_state") @db.VarChar(80)
  paymentMethod String        @map("payment_method") @db.VarChar(80)
  items         OrderItem[]
  user          User          @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  productId    String         @map("product_id") @db.Uuid
  variantId    String         @map("variant_id") @db.Uuid
  productName  String         @map("product_name") @db.VarChar(160)
  variantLabel String         @map("variant_label") @db.VarChar(80)
  unitPrice    Decimal        @map("unit_price") @db.Decimal(12, 2)
  quantity     Int
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}
